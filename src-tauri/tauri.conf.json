{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinCraft",
  "mainBinaryName": "WinCraft",
  "version": "1.19.0",
  "identifier": "com.wincraft.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WinCraft",
        "width": 1000,
        "height": 700,
        "minWidth": 820,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost https://api.wincraft.app https://api.pwnedpasswords.com; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AurelioAvila/pc-tweaker-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNDA3NzYyMzQ4NjMyRDIKUldUU01vWTBZbmRBR3Z1bEN3N2xYK0VIeUwzaEo4UU1lS2ZMR25xMlFHZ2FuUEZvZENzcXdldDYK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "Craft your perfect Windows experience — free tweaks, optimization and privacy tools",
    "publisher": "Aurelio Avila",
    "copyright": "Copyright © 2026 WinCraft Contributors. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "wix": {
        "upgradeCode": "8D2CADB9-D0FC-51AC-989D-06B9BDCE5614"
      }
    }
  }
}

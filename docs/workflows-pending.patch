diff --git a/.github/workflows/checks.yml b/.github/workflows/checks.yml
index 74db682..98a6ef6 100644
--- a/.github/workflows/checks.yml
+++ b/.github/workflows/checks.yml
@@ -190,8 +190,45 @@ jobs:
       - name: Native power policies on a disposable inactive plan
         run: cargo test --manifest-path src-tauri/Cargo.toml --lib power_tuning::tests::inactive_windows_plan_roundtrip -- --ignored --nocapture
 
-      - name: Backend unit tests
+      # Offline: the script loads install.ps1 as a library and substitutes the
+      # signature, download and launch commands, so it needs no release assets.
+      - name: Quick installer regressions
+        shell: pwsh
+        run: ./scripts/test-quick-installer.ps1
+
+  # Its own job so the checks above keep their runtime, and so the backend
+  # tests run against a real PostgreSQL: three of them (transaction rollback,
+  # account deletion, retention) skip without one, which is how a regression in
+  # the money-and-data paths could reach a release unnoticed.
+  backend:
+    if: ${{ !inputs.release_tag }}
+    runs-on: ubuntu-latest
+    services:
+      postgres:
+        image: postgres:16
+        env:
+          POSTGRES_PASSWORD: postgres
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd pg_isready --health-interval 10s --health-timeout 5s
+          --health-retries 5
+    steps:
+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5
+        with:
+          persist-credentials: false
+
+      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5
+        with:
+          node-version: 22
+
+      - name: Backend unit tests, against a real PostgreSQL
         working-directory: backend
+        env:
+          # A loopback plaintext connection is allowed only outside production;
+          # the pool itself is created by each test from TEST_DATABASE_URL.
+          TEST_DATABASE_URL: postgresql://postgres:postgres@127.0.0.1:5432/postgres
+          DATABASE_ALLOW_PLAINTEXT: "true"
         run: npm ci && npm test
 
   installers:
diff --git a/.github/workflows/deploy-site.yml b/.github/workflows/deploy-site.yml
index 23903ac..ecf9cca 100644
--- a/.github/workflows/deploy-site.yml
+++ b/.github/workflows/deploy-site.yml
@@ -52,7 +52,13 @@ jobs:
       - run: npm ci
       - run: npm run build
       - run: npm run check:seo
+      # `enablement: true` creates the Pages site on the first run when it does
+      # not exist yet, which is the state this repository is in: every deploy so
+      # far failed here with `HttpError: Not Found` from the Pages API. The job
+      # already has `pages: write`, which is what the parameter needs.
       - uses: actions/configure-pages@983d7736d9b0ae728b81ab479565c72886d7745b # v5
+        with:
+          enablement: true
       - uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3
         with:
           path: site/dist

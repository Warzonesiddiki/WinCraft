{
  "name": "pctweaker-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && npm run check:output",
    "preview": "vite preview",
    "check:seo": "node scripts/check-seo.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "check:reveals": "node scripts/check-reveals.mjs",
    "check:hydration": "node scripts/check-hydration.mjs",
    "check:output": "npm run check:fonts && npm run check:reveals && npm run check:hydration",
    "sitemap": "node scripts/build-sitemap.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
